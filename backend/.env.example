# ==========================================================
# APPLICATION
# ==========================================================

APP_NAME=PLN Analytics Platform API
ENVIRONMENT=development
DEBUG=true

# ==========================================================
# CORS
# ==========================================================

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ==========================================================
# AUTH
# ==========================================================

AUTH_ENABLED=false
AUTH_REQUIRED=false
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_EXPIRES_MINUTES=480

# In production, AUTH_REQUIRED defaults to true (see app/core/config.py) --
# the dashboard shows real customer data and must not be public. Set these
# two in the deployment's own environment variables (not committed here) to
# bootstrap the one admin account; USERS_FILE is regenerated from them on
# every restart since this host's disk does not persist across deploys.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-real-password

# ==========================================================
# DATA
# ==========================================================

DATA_PROCESSED_DIR=./data/processed
DATA_RAW_DIR=./data/raw
DATA_INCOMING_DIR=./data/raw/incoming
DATA_AUTH_DIR=./data/auth

# ==========================================================
# PERFORMANCE / OOM PROTECTION
# ==========================================================

DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
CACHE_TTL_SECONDS=120
DLPD_STREAM_CHUNK_ROWS=250
DRIVE_DOWNLOAD_CHUNK_MB=16
JOB_STATE_STORAGE=local

# DuckDB is capped at 1 thread / 192MB by default (see
# app/database/warehouse.py) because production runs on a small memory
# tier. That cap applies everywhere, including local development, and is
# the main reason the DLPD Monitoring page can feel like it hangs for
# minutes -- especially with "Semua Bulan" selected (a full scan with no
# month filter). If you have real CPU/RAM headroom on your own machine,
# uncomment and raise these:
# DUCKDB_MEMORY_LIMIT=2GB
# DUCKDB_THREADS=4

# The 8 heaviest DLPD read endpoints (months/filters/dashboard/
# dashboard-ulp/customers/detail/export/map) are serialized behind one
# process-wide lock so concurrent scans can't OOM the small production
# tier. The DLPD Monitoring page fires several of these at once, so on
# production's single thread they queue up one-by-one. Safe to disable
# locally (ideally together with raising DUCKDB_THREADS/DUCKDB_MEMORY_LIMIT
# above) so they can run in parallel instead. NEVER set this to false in a
# real deployment.
# DLPD_QUERY_GUARD_ENABLED=false

# Local development only: lets Google Drive sync actually run without R2/S3
# credentials, by treating this machine's own disk as durable enough (which
# it is -- unlike an ephemeral cloud container, nothing recycles it out from
# under a running process). NEVER set this in a real deployment's own
# environment variables.
ALLOW_LOCAL_DURABLE_JOBS=true

# ==========================================================
# GOOGLE DRIVE SOURCE
# ==========================================================

# The backend recursively reads Excel files from this folder.
GOOGLE_DRIVE_FOLDER_ID=1FhaB_rp04Xtj4uy0h7wfg6G_fOXgY4N-

# Put the service-account JSON in an environment secret.
# Prefer the base64 variant on hosts that do not preserve multiline values.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://pln-analytics-platform.fastapicloud.dev/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://pln-analytics-platform.fastapicloud.dev/health"
    },
    {
      "source": "/health/:path*",
      "destination": "https://pln-analytics-platform.fastapicloud.dev/health/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
